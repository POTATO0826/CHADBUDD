{
  "name": "chadbuddy",
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^5"
  },
  "private": true,
  "scripts": {
    "dev": "bun run server.ts",
    "build": "bun run build.ts",
    "fonts": "bun run scripts/fetch-fonts.ts",
    "verify:seed": "bun run scripts/verify-seed.ts",
    "verify:ui": "bun run scripts/verify-ui.ts",
    "check": "bunx tsc --noEmit",
    "check:backend": "bunx tsc --noEmit -p bridge/tsconfig.json",
    "test:backend": "bun test bridge/",
    "tg:check": "bun run bridge/telegram/check.ts",
    "tg:spike": "bun run bridge/telegram/spike.ts",
    "convex:dev": "bunx convex dev",
    "convex:codegen": "bunx convex codegen",
    "bridge": "bun run bridge/main.ts",
    "agent:check": "bun run bridge/agent/check.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "seed:load": "bun run bridge/seed-load.ts",
    "agent:run": "bunx convex run agent:analyzeAll",
    "agent:verify": "bun run bridge/agent/verify-cites.ts"
  },
  "type": "module",
  "dependencies": {
    "convex": "^1.44.0",
    "telegram": "^2.26.22",
    "clsx": "^2.1.1",
    "motion": "^13.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  }
}
