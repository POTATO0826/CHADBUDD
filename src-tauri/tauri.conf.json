{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voltage",
  "version": "0.1.0",
  "identifier": "dev.voltage.hud",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Voltage",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 480,
        "transparent": true,
        "decorations": true,
        "shadow": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
